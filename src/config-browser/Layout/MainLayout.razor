@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<div class="app-shell">
    <aside class="app-sidebar">
        <div class="sidebar-brand">
            <div class="brand-mark">CB</div>
            <div class="brand-block">
                <div class="brand-row">
                    <a class="brand-link" href="">Config Browser</a>
                    <span class="product-tag">Internal</span>
                </div>
                <p class="brand-copy">Secure GitHub-backed configuration workspace</p>
            </div>
        </div>

        <div class="sidebar-section">
            <p class="sidebar-heading">Workspace</p>
            <NavLink href="" Match="NavLinkMatch.All" class="nav-item">
                <span class="nav-item-label">Config catalog</span>
                <span class="nav-item-hint">Browse outputs</span>
            </NavLink>

            <div class="nav-item @(IsDetailsPage ? "active" : string.Empty)">
                <span class="nav-item-label">Config details</span>
                <span class="nav-item-hint">Inspect selected file</span>
            </div>
        </div>

        <div class="sidebar-section sidebar-note">
            <p class="sidebar-heading">Environment</p>
            <div class="note-card">
                <strong>User-scoped access</strong>
                <span>Review live configuration state, commit history, and promotion activity.</span>
            </div>
        </div>
    </aside>

    <div class="app-workspace">
        <header class="workspace-header">
            <div class="workspace-header-copy">
                <span class="workspace-kicker">Operations Console</span>
                <div class="workspace-title">@(IsDetailsPage ? "Configuration Detail Workspace" : "Configuration Control Center")</div>
                <p class="workspace-summary">Structured review and controlled promotion for live GitHub-managed configuration.</p>
            </div>

            <div class="workspace-meta">
                <span class="workspace-pill">GitHub-backed</span>
                <span class="workspace-pill">Sign-in required</span>
            </div>
        </header>

        <main class="app-main">
            @Body
        </main>
    </div>
</div>

@code {
    private bool IsDetailsPage => NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith("config", StringComparison.OrdinalIgnoreCase);
}
