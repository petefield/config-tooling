@page "/"
@inject ConfigDataService DataService
@inject GitHubPromotionService PromotionService
@inject NavigationManager NavigationManager

<PageTitle>Config Browser</PageTitle>

@if (isLoading)
{
    <section class="state-card">
        <h1>Loading config catalog</h1>
        <p>Reading the live config catalog and available files.</p>
    </section>
}
else if (requiresSignIn)
{
    <section class="state-card">
        <h1>Sign in required</h1>
        <p>@signInMessage</p>
        <div class="state-actions">
            <button type="button" class="sign-in-button" @onclick="SignInAsync">Sign in with GitHub</button>
        </div>
    </section>
}
else if (errorMessage is not null)
{
    <section class="state-card error-state">
        <h1>Config data unavailable</h1>
        <p>@errorMessage</p>
    </section>
}
else if (catalog is null || catalog.Entries.Count == 0)
{
    <section class="state-card">
        <h1>No config files found</h1>
        <p>No config files were found in the configured GitHub repository.</p>
    </section>
}
else
{
    <section class="hero-card">
        <div>
            <h1>Config browser</h1>
            <p>Filter the live GitHub config repository by tenant, environment, and contact type, then open any config for a clean detail view.</p>
        </div>

        <dl class="hero-stats">
            <div>
                <dt>Files</dt>
                <dd>@catalog.Entries.Count</dd>
            </div>
            <div>
                <dt>Tenants</dt>
                <dd>@TenantOptions.Count(option => option != AllOption)</dd>
            </div>
            <div>
                <dt>Repo updated</dt>
                <dd>@catalog.GeneratedAtUtc.ToLocalTime().ToString("g")</dd>
            </div>
        </dl>
    </section>

    <section class="browser-grid">
        <section class="filters-card">
            <h2>Filters</h2>

            <div class="filters-row">
                <label class="filter-field" for="tenant-filter">
                    <span>Tenant</span>
                    <select id="tenant-filter" @bind="selectedTenant" @bind:after="EnsureSelectedFiltersAreValid">
                        @foreach (var tenant in TenantOptions)
                        {
                            <option value="@tenant">@FormatTenantOrEnvironmentOptionLabel(tenant)</option>
                        }
                    </select>
                </label>

                <label class="filter-field" for="environment-filter">
                    <span>Environment</span>
                    <select id="environment-filter" @bind="selectedEnvironment" @bind:after="EnsureSelectedFiltersAreValid">
                        @foreach (var environment in EnvironmentOptions)
                        {
                            <option value="@environment">@FormatTenantOrEnvironmentOptionLabel(environment)</option>
                        }
                    </select>
                </label>

                <label class="filter-field" for="contact-type-filter">
                    <span>Contact type</span>
                    <select id="contact-type-filter" @bind="selectedContactType">
                        @foreach (var contactType in ContactTypeOptions)
                        {
                            <option value="@contactType">@FormatContactTypeOptionLabel(contactType)</option>
                        }
                    </select>
                </label>
            </div>
        </section>

        <section class="results-card">
            <div class="results-header">
                <div>
                    <h2>Config files</h2>
                    <p>@FilteredEntries.Count entry@(FilteredEntries.Count == 1 ? string.Empty : "ies") match the current filters.</p>
                </div>
            </div>

            @if (FilteredEntries.Count == 0)
            {
                <div class="empty-results">
                    <p>No live configs match the current filter selection.</p>
                </div>
            }
            else
            {
                <div class="results-table-wrap">
                    <table class="results-table">
                        <thead>
                            <tr>
                                <th>Tenant</th>
                                <th>Environment</th>
                                <th>Contact Type</th>
                                <th>Channel</th>
                                <th>File</th>
                                <th>Source</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in FilteredEntries)
                            {
                                <tr class="clickable-row"
                                    @onclick="@(() => OpenDetails(entry))"
                                    @onkeydown="@((KeyboardEventArgs args) => HandleRowKeyDown(args, entry))"
                                    tabindex="0">
                                    <td><span class="table-badge">@entry.Tenant</span></td>
                                    <td>@entry.Environment.ToUpperInvariant()</td>
                                    <td>@entry.ContactType</td>
                                    <td>@entry.Channel</td>
                                    <td>
                                        <span class="table-link">@entry.FileName</span>
                                    </td>
                                    <td><code>@entry.SourceFile</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </section>
}

@code {
    private const string AllOption = "all";

    private ConfigCatalog? catalog;
    private bool isLoading = true;
    private bool requiresSignIn;
    private string? errorMessage;
    private string signInMessage = "Sign in with GitHub to browse config data.";
    private string selectedTenant = AllOption;
    private string selectedEnvironment = AllOption;
    private string selectedContactType = AllOption;

    private int ToDisplayOrder(string environmentName) => environmentName.ToLowerInvariant() switch {
        "dev" => 0,
        "uat" => 1,
        "prd" => 2,
        _ => 3
    };

    private IReadOnlyList<ConfigCatalogEntry> FilteredEntries =>
        catalog?.Entries
            .Where(MatchesTenant)
            .Where(MatchesEnvironment)
            .Where(MatchesContactType)
            .OrderBy(x => x.FileName).ThenBy(x => ToDisplayOrder(x.Environment))
            .ToArray() ?? [];

    private IReadOnlyList<string> TenantOptions =>
        catalog is null
            ? [AllOption]
            : [AllOption, .. catalog.Entries
                .Select(static entry => entry.Tenant)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(static value => value, StringComparer.OrdinalIgnoreCase)];

    private IReadOnlyList<string> EnvironmentOptions
    {
        get
        {
            if (catalog is null)
            {
                return [AllOption];
            }

            var entries = selectedTenant == AllOption
                ? catalog.Entries
                : catalog.Entries.Where(entry => string.Equals(entry.Tenant, selectedTenant, StringComparison.OrdinalIgnoreCase));

            return [AllOption, .. entries
                .Select(static entry => entry.Environment)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(static value => value, StringComparer.OrdinalIgnoreCase)];
        }
    }

    private IReadOnlyList<string> ContactTypeOptions
    {
        get
        {
            if (catalog is null)
            {
                return [AllOption];
            }

            var entries = catalog.Entries
                .Where(MatchesTenant)
                .Where(MatchesEnvironment);

            return [AllOption, .. entries
                .Select(static entry => entry.ContactType)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(static value => value, StringComparer.OrdinalIgnoreCase)];
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogAsync();
    }

    private async Task LoadCatalogAsync()
    {
        isLoading = true;
        requiresSignIn = false;
        errorMessage = null;

        try
        {
            catalog = await DataService.GetCatalogAsync();
        }
        catch (GitHubAuthenticationRequiredException exception)
        {
            catalog = null;
            requiresSignIn = true;
            signInMessage = exception.Message;
        }
        catch (Exception exception)
        {
            catalog = null;
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SignInAsync()
    {
        signInMessage = "Sign in with GitHub to browse config data.";

        try
        {
            await PromotionService.SignInAsync(GetAppOrigin());
            await LoadCatalogAsync();
        }
        catch (Exception exception)
        {
            requiresSignIn = true;
            isLoading = false;
            signInMessage = exception.Message;
        }
    }

    private static string BuildDetailsUri(ConfigCatalogEntry entry) =>
        $"config?path={Uri.EscapeDataString(entry.OutputFile)}";

    private void OpenDetails(ConfigCatalogEntry entry) =>
        NavigationManager.NavigateTo(BuildDetailsUri(entry));

    private static string FormatTenantOrEnvironmentOptionLabel(string value) =>
        value == AllOption ? "All" : value.ToUpperInvariant();

    private static string FormatContactTypeOptionLabel(string value) =>
        value == AllOption ? "All" : value;

    private string GetAppOrigin() =>
        NavigationManager.ToAbsoluteUri(NavigationManager.Uri).GetLeftPart(UriPartial.Authority);

    private bool MatchesTenant(ConfigCatalogEntry entry) =>
        selectedTenant == AllOption ||
        string.Equals(entry.Tenant, selectedTenant, StringComparison.OrdinalIgnoreCase);

    private bool MatchesEnvironment(ConfigCatalogEntry entry) =>
        selectedEnvironment == AllOption ||
        string.Equals(entry.Environment, selectedEnvironment, StringComparison.OrdinalIgnoreCase);

    private bool MatchesContactType(ConfigCatalogEntry entry) =>
        selectedContactType == AllOption ||
        string.Equals(entry.ContactType, selectedContactType, StringComparison.OrdinalIgnoreCase);

    private void EnsureSelectedFiltersAreValid()
    {
        if (!EnvironmentOptions.Contains(selectedEnvironment, StringComparer.OrdinalIgnoreCase))
        {
            selectedEnvironment = AllOption;
        }

        if (!ContactTypeOptions.Contains(selectedContactType, StringComparer.OrdinalIgnoreCase))
        {
            selectedContactType = AllOption;
        }
    }

    private void HandleRowKeyDown(KeyboardEventArgs args, ConfigCatalogEntry entry)
    {
        if (args.Key is "Enter" or " ")
        {
            OpenDetails(entry);
        }
    }

    private static string GetLastChangeSummary(ConfigCatalogEntry entry)
    {
        var lastChange = entry.Modifications.FirstOrDefault();

        return lastChange is null
            ? "No git history found"
            : $"{lastChange.Message} • {lastChange.AuthorDate.ToLocalTime():g}";
    }

    private static string GetPrdMatchLabel(ConfigCatalogEntry entry) =>
        !string.Equals(entry.Environment, "uat", StringComparison.OrdinalIgnoreCase)
            ? "—"
            : entry.HasMatchingPrdVersion == true ? "Yes" : "No";
}
