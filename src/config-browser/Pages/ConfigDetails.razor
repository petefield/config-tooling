    private static string GetMatchFieldLabel(ConfigCatalogEntry entry) =>
        string.Equals(entry.Environment, "dev", StringComparison.OrdinalIgnoreCase)
            ? "Matching UAT version"
            : string.Equals(entry.Environment, "uat", StringComparison.OrdinalIgnoreCase)
                ? "Matching PRD version"
                : "Matching next version";

    private static string GetMatchFieldValue(ConfigCatalogEntry entry) =>
        string.Equals(entry.Environment, "dev", StringComparison.OrdinalIgnoreCase)
            ? entry.HasMatchingUatVersion == true ? "Yes" : "No"
            : string.Equals(entry.Environment, "uat", StringComparison.OrdinalIgnoreCase)
                ? entry.HasMatchingPrdVersion == true ? "Yes" : "No"
                : "—";

    private static string GetPromoteButtonLabel(ConfigCatalogEntry? entry, bool isPromoting) =>
        isPromoting
            ? "Creating PR..."
            :
        entry is null
            ? "Promote"
            : $"Promote to {GetPromotionTargetEnvironment(entry).ToUpperInvariant()}";


    private async Task ConfirmPromoteAsync()
    {
        if (selectedEntry is null)
        {
            return;
        }

        promotionErrorMessage = null;
        promotionMessage = null;
        promotionPullRequestUrl = null;

        if (!await PromotionService.HasAuthenticatedSessionAsync())
        {
            try
            {
                await PromotionService.SignInAsync(NavigationManager.ToAbsoluteUri(NavigationManager.Uri).GetLeftPart(UriPartial.Authority));
            }
            catch (Exception exception)
            {
                promotionErrorMessage = exception.Message;
                return;
            }
        }

        showPromoteModal = true;
    }

    private void ClosePromoteModal()
    {
        if (isPromoting)
        {
            return;
        }

        promotionErrorMessage = null;
        showPromoteModal = false;
    }

    private async Task PromoteAsync()
    {
        if (selectedEntry is null)
        {
            return;
        }

        promotionErrorMessage = null;
        isPromoting = true;

        try
        {
            var catalog = await DataService.GetCatalogAsync();
            var fileContents = await DataService.GetConfigTextAsync(selectedEntry.OutputFile);
            var result = await PromotionService.PromoteAsync(catalog.Repository, selectedEntry, fileContents);

            promotionPullRequestUrl = result.PullRequestUrl;
            promotionMessage = $"Created branch '{result.BranchName}' and pull request #{result.PullRequestNumber}.";
            showPromoteModal = false;
        }
        catch (Exception exception)
        {
            promotionErrorMessage = exception.Message;
        }
        finally
        {
            isPromoting = false;
        }
    }

    private static string GetPromotionTargetEnvironment(ConfigCatalogEntry entry) =>
        string.Equals(entry.Environment, "dev", StringComparison.OrdinalIgnoreCase) ? "uat" : "prd";

    private static string FormatJson(JsonElement element) =>
        JsonSerializer.Serialize(element, JsonOptions);
}
