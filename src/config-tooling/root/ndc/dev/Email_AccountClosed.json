{
    "operationUnit": "atc",
    "connector": "Salesforce",
    "channel": "Letter",
    "trigger": "ProactiveLimitIncreaseCompleted",
    "outputType": "JSON",
    "inputData": [
        {
            "name": "accountId",
            "type": "string",
            "path": "$.account.accountId"
        },
        {
            "name": "accountNumber",
            "type": "string",
            "path": "$.account.accountNumber",
            "required": true
        },
        {
            "name": "fromLimit",
            "type": "string",
            "path": "$.limitChange.fromLimit"
        },
        {
            "name": "toLimit",
            "type": "string",
            "path": "$.limitChange.toLimit"
        },
        {
            "name": "creditLimitPreference",
            "type": "string",
            "path": "$.limitChange.creditLimitPreference"
        },
        {
            "name": "product",
            "type": "String",
            "path": "$.product.productKey",
            "required": true
        }
    ],
    "mapping": [
        {
            "inputField": "#ActivationNotificationEmail_03",
            "outputField": "templateId"
        },
        {
            "inputField": "#ProactiveLimitIncreaseValidated",
            "outputField": "CommunicationId"
        },
        {
            "inputField": "System.BrandName",
            "outputField": "Brand"
        },
        {
            "inputField": "System.GivenName",
            "outputField": "GivenName"
        },
        {
            "inputField": "@Context.Input['accountId'].PurifyAccNo()",
            "outputField": "CustomerId"
        },
        {
            "inputField": "System.PersonalEmail",
            "outputField": "EmailAddress"
        }
    ],
    "condition": {
        "expression": "Context.Input['creditLimitPreference'].Is('0')",
        "description": "Send communication if creditLimitPreference is 0"
    },
    "featureFlags": [
        {
            "tenant": "ndc",
            "enabled": true,
            "environments": [
                "all"
            ]
        },
        {
            "tenant": "a05",
            "enabled": true,
            "environments": [
                "all"
            ]
        }
    ]
}